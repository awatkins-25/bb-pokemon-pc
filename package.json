{
  "name": "bb-plugin-pokemon-pc",
  "version": "0.2.2",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132",
    "node": ">=22"
  },
  "bb": {
    "name": "Pokémon PC",
    "description": "Build a custom Pokémon agent party with persistent Poké Ball tasks and an animated, collapsible activity EXP bar.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "themes": [
      {
        "id": "daylight",
        "name": "Pokémon PC — Cobalt",
        "description": "A light PC sidebar and soft cobalt accents for the Apple Notes layout.",
        "css": "./themes/daylight.css",
        "codeTheme": {
          "light": "github-light",
          "dark": "github-dark"
        }
      }
    ]
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.6",
    "esbuild": "^0.28.2",
    "hono": "^4.13.19",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "node test.mjs && node frontend-test.mjs",
    "preview:build": "node preview/build.mjs",
    "test:browser": "node preview/build.mjs && node preview/check.mjs"
  },
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
